<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="WindowSill.ClipboardHistory.Settings.SettingsView"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///WindowSill.ClipboardHistory/UI/ClipboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style x:Key="ClipboardSettingsCardStyle" TargetType="controls:SettingsCard">
                <Setter Property="MinHeight" Value="76" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="24" Padding="0,0,0,24">
        <StackPanel Spacing="4">
            <TextBlock
                Text="{x:Bind Localize('SettingsHistoryGroup')}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Margin="0,0,0,8" />
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/MaxItemNumber"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe UI" Glyph="#" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox
                    Width="160"
                    Maximum="1000000"
                    Minimum="-1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.MaximumHistoryCount, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind SettingLabel('MaxItemNumber')}" />
            </controls:SettingsCard>
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/PersistentHistory"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE753;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.PersistentHistory, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind SettingLabel('PersistentHistory')}" />
            </controls:SettingsCard>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock
                Text="{x:Bind Localize('SettingsDisplayGroup')}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Margin="0,0,0,8" />
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/CompactMode"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE14C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.CompactMode, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind SettingLabel('CompactMode')}" />
            </controls:SettingsCard>
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/OverrideWindowsV"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.OverrideWindowsV, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind SettingLabel('OverrideWindowsV')}" />
            </controls:SettingsCard>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock
                Text="{x:Bind Localize('WorkspacePrivacy')}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Margin="0,0,0,8" />
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/HidePasswords"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9A9;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.HidePasswords, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind SettingLabel('HidePasswords')}" />
            </controls:SettingsCard>
            <controls:SettingsCard
                Style="{StaticResource ClipboardSettingsCardStyle}"
                Header="{x:Bind Localize('SettingsCaptureHeader')}"
                Description="{x:Bind Controls.CaptureStatus, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE769;" />
                </controls:SettingsCard.HeaderIcon>
                <DropDownButton
                    Content="{x:Bind Localize('SettingsCaptureActions')}"
                    IsEnabled="{x:Bind Controls.CanInteract, Mode=OneWay}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspacePause15')}"
                                Command="{x:Bind Controls.Pause15Command}" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspacePauseHour')}"
                                Command="{x:Bind Controls.PauseHourCommand}" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspacePauseManual')}"
                                Command="{x:Bind Controls.PauseUntilResumeCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceResume')}"
                                Command="{x:Bind Controls.ResumeCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </controls:SettingsCard>
            <controls:SettingsCard
                Style="{StaticResource ClipboardSettingsCardStyle}"
                Header="{x:Bind Localize('SettingsPresentationHeader')}"
                Description="{x:Bind Localize('SettingsPresentationDescription')}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B3;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    Content="{x:Bind Controls.ShortPresentationAction, Mode=OneWay}"
                    Command="{x:Bind Controls.TogglePresentationCommand}"
                    IsEnabled="{x:Bind Controls.CanInteract, Mode=OneWay}" />
            </controls:SettingsCard>
            <TextBlock
                Text="{x:Bind Localize('SettingsPauseHelp')}"
                Style="{StaticResource ClipboardSecondaryTextStyle}"
                Margin="0,8,0,0" />
            <InfoBar
                IsOpen="{x:Bind Controls.HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind Controls.Error, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock
                Text="{x:Bind Localize('SettingsSystemGroup')}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Margin="0,0,0,8" />
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/OpenWindowsClipboardHistorySettings"
                Click="OpenWindowsClipboardHistorySettingsCard_Click"
                IsClickEnabled="True"
                Visibility="{x:Bind ViewModel.IsClipboardHistoryEnabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/EnableClipboardHistory"
                Click="OpenWindowsClipboardHistorySettingsCard_Click"
                IsClickEnabled="True"
                Visibility="{x:Bind ViewModel.IsClipboardHistoryDisabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>
            <controls:SettingsCard
                api:Uids.Uid="/WindowSill.ClipboardHistory/SettingsUserControl/Updates"
                Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                Style="{StaticResource ClipboardSettingsCardStyle}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    Click="UpdateActionButton_Click"
                    Content="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsUpdateActionEnabled, Mode=OneWay}" />
            </controls:SettingsCard>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasLaunchError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.LaunchError, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
