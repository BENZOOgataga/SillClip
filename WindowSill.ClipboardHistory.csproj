<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>WindowSill.ClipboardHistory</PackageId>
        <Version>0.10.0-unlimited.1</Version>
        <Authors>Etienne Baudoux, BENZOOgataga</Authors>
        <Title>Clipboard History No Limits</Title>
        <Description>
          Never lose what you've copied again. Access your clipboard history instantly and paste any previous item with a single click or keyboard shortcut.

          Key features:
          Tracks text, images, URIs, colors and files.
          Searches large histories from a dedicated popup.
          Keeps an encrypted history across restarts.
          Supports unlimited, 500, 1000 or custom retention limits.
          Opens the searchable history with Win+V.
          Checks GitHub Releases for extension updates.

          Your clipboard, supercharged.
        </Description>
        <PackageIcon>Assets/package.png</PackageIcon>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/BENZOOgataga/WindowSill-NoClipBoardHistoryLimit</PackageProjectUrl>
      <RepositoryUrl>https://github.com/BENZOOgataga/WindowSill-NoClipBoardHistoryLimit</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <None Include="Assets/package.png" Pack="true" PackagePath="\Assets\" />
        <None Include="LICENSE.md" Pack="true" PackagePath="\" />
        <None Include="CHANGELOGS.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="WindowSill.API" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>
</Project>
