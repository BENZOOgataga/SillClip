<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>WindowSill.ClipboardHistory.NoLimits</PackageId>
        <AssemblyName>WindowSill.ClipboardHistory</AssemblyName>
        <Version>0.10.1</Version>
        <Authors>Etienne Baudoux, BENZOOgataga</Authors>
        <Title>Clipboard History No Limits</Title>
        <Description>
          A free fork of WindowSill Clipboard History with custom or unlimited retention,
          encrypted storage across restarts, search, and a Win+V popup.
          Set the item limit to 0 or -1 for unlimited history, or use a positive number.
        </Description>
        <PackageIcon>Assets/package.png</PackageIcon>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/BENZOOgataga/WindowSill-NoClipBoardHistoryLimit</PackageProjectUrl>
      <RepositoryUrl>https://github.com/BENZOOgataga/WindowSill-NoClipBoardHistoryLimit</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <Content Remove="Assets/package.png" />
        <None Include="Assets/package.png" Pack="true" PackagePath="\Assets\" />
        <None Update="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE.md" Pack="true" PackagePath="\" />
        <None Include="CHANGELOGS.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NuGet.Versioning" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Windows.CsWin32">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="WindowSill.API" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>
</Project>
