<?xml version="1.0" encoding="utf-8" ?>
<api:SillPopupContent
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowSill.ClipboardHistory.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:WindowSill.ClipboardHistory.UI"
    xmlns:vm="using:WindowSill.ClipboardHistory.ViewModels"
    x:Class="WindowSill.ClipboardHistory.Views.ClipboardHistoryPopupContent"
    Width="360"
    Height="400"
    mc:Ignorable="d">
    <api:SillPopupContent.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///WindowSill.ClipboardHistory/UI/ClipboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Text / Html / Rtf template  -->
            <DataTemplate x:Key="TextItemTemplate" x:DataType="vm:TextItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  Html template (shares text layout)  -->
            <DataTemplate x:Key="HtmlItemTemplate" x:DataType="vm:HtmlItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  Rtf template (shares text layout)  -->
            <DataTemplate x:Key="RtfItemTemplate" x:DataType="vm:RtfItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  Image template  -->
            <DataTemplate x:Key="ImageItemTemplate" x:DataType="vm:ImageItemViewModel">
                <Grid Height="80" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        MaxWidth="72"
                        MaxHeight="56"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Width="72"
                        Height="56">
                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Size, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  URI template  -->
            <DataTemplate x:Key="UriItemTemplate" x:DataType="vm:UriItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE71B;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Url, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind OpenInBrowserCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind OpenTooltip}"
                        AutomationProperties.Name="{x:Bind OpenTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  Application Link template  -->
            <DataTemplate x:Key="AppLinkItemTemplate" x:DataType="vm:ApplicationLinkItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE71B;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind OpenApplicationCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind OpenTooltip}"
                        AutomationProperties.Name="{x:Bind OpenTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  Color template  -->
            <DataTemplate x:Key="ColorItemTemplate" x:DataType="vm:ColorItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{x:Bind BackgroundBrush, Mode=OneWay}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind ColorText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  File template  -->
            <DataTemplate x:Key="FileItemTemplate" x:DataType="vm:FileItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Grid.Column="0" VerticalAlignment="Center" Symbol="Document" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind OpenInFileExplorerCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind OpenTooltip}"
                        AutomationProperties.Name="{x:Bind OpenTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  UserActivity template  -->
            <DataTemplate x:Key="UserActivityItemTemplate" x:DataType="vm:UserActivityItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE823;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  Unknown / Default template  -->
            <DataTemplate x:Key="UnknownItemTemplate" x:DataType="vm:UnknownItemViewModel">
                <Grid MinHeight="64" Padding="12,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE9CE;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind DisplayText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        MaxLines="3" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{x:Bind TogglePinCommand}"
                        IsEnabled="{x:Bind CanTogglePin, Mode=OneWay}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind PinGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Command="{x:Bind DeleteCommand}"
                        Style="{StaticResource ClipboardItemActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                        AutomationProperties.Name="{x:Bind DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <local:ClipboardPopupItemTemplateSelector
                x:Key="PopupItemTemplateSelector"
                AppLinkTemplate="{StaticResource AppLinkItemTemplate}"
                ColorTemplate="{StaticResource ColorItemTemplate}"
                DefaultTemplate="{StaticResource UnknownItemTemplate}"
                FileTemplate="{StaticResource FileItemTemplate}"
                HtmlTemplate="{StaticResource HtmlItemTemplate}"
                ImageTemplate="{StaticResource ImageItemTemplate}"
                RtfTemplate="{StaticResource RtfItemTemplate}"
                TextTemplate="{StaticResource TextItemTemplate}"
                UriTemplate="{StaticResource UriItemTemplate}"
                UserActivityTemplate="{StaticResource UserActivityItemTemplate}" />
        </ResourceDictionary>
    </api:SillPopupContent.Resources>
    <Grid>
        <Grid x:Name="HistoryPanel" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Header  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="DragHandle"
                    Grid.Column="0"
                    Background="Transparent"
                    PointerPressed="DragHandle_PointerPressed"
                    PointerMoved="DragHandle_PointerMoved"
                    PointerReleased="DragHandle_PointerReleased"
                    PointerCaptureLost="DragHandle_PointerCaptureLost">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        Text="{x:Bind PopupTitle}" />
                </Border>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ClearAllCommand}"
                    ToolTipService.ToolTip="{x:Bind ClearHistoryTooltip}"
                    Height="36"
                    Padding="12,0"
                    Margin="0,0,8,0">
                    <TextBlock Text="{x:Bind ClearAllText}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource ClipboardToolbarButtonStyle}"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="{x:Bind CloseTooltip}"
                    AutomationProperties.Name="{x:Bind CloseTooltip}">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    AutomationProperties.Name="{x:Bind SearchPlaceholder}"
                    PlaceholderText="{x:Bind SearchPlaceholder}"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Height="36"
                    VerticalAlignment="Center">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Width="16" Height="16" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="{x:Bind Localize('WorkspaceFilters')}"
                    ToolTipService.ToolTip="{x:Bind Localize('WorkspaceFilters')}"
                    Style="{StaticResource ClipboardToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceAllItems')}"
                                Tag=""
                                Click="SearchPreset_Click" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceImages')}"
                                Tag="type:image"
                                Click="SearchPreset_Click" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceLinks')}"
                                Tag="type:uri"
                                Click="SearchPreset_Click" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceTextItems')}"
                                Tag="type:text"
                                Click="SearchPreset_Click" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspacePinnedItems')}"
                                Tag="pinned:true"
                                Click="SearchPreset_Click" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceToday')}"
                                Tag="today"
                                Click="SearchPreset_Click" />
                            <MenuFlyoutItem
                                Text="{x:Bind Localize('WorkspaceLastWeek')}"
                                Tag="week"
                                Click="SearchPreset_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="2"
                    Click="OpenWorkspace_Click"
                    AutomationProperties.AutomationId="SillClipWorkspaceButton"
                    AutomationProperties.Name="{x:Bind Localize('WorkspaceManage')}"
                    ToolTipService.ToolTip="{x:Bind Localize('WorkspaceManage')}"
                    Style="{StaticResource ClipboardToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </Grid>
            <!--  Clipboard items list  -->
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                api:Uids.Uid="/WindowSill.ClipboardHistory/Misc/EmptyClipboard"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.EmptyClipboardIndicatorVisibility, Mode=OneWay}" />
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind NoSearchResultsText}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.NoSearchResultsVisibility, Mode=OneWay}" />
            <ui:ShortcutListView
                x:Name="ClipboardItems"
                Grid.Row="2"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="ClipboardItemsShortcutListView_ItemClick"
                ItemInvoked="ClipboardItemsShortcutListView_ItemInvoked"
                ContainerContentChanging="ClipboardItems_ContainerContentChanging"
                ItemTemplateSelector="{StaticResource PopupItemTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="Single">
                <ui:ShortcutListView.ItemContainerStyle>
                    <Style TargetType="ui:ShortcutListViewItem">
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ui:ShortcutListView.ItemContainerStyle>
                <ui:ShortcutListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ui:ShortcutListView.ItemsPanel>
                <ui:ShortcutListView.Template>
                    <ControlTemplate TargetType="ui:ShortcutListView">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="ScrollViewer"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ui:ShortcutListView.Template>
            </ui:ShortcutListView>
            <StackPanel Grid.Row="3" Margin="0" Spacing="4">
                <TextBlock
                    Text="{x:Bind ViewModel.QueryError, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.QueryErrorVisibility, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind Controls.CaptureStatus, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ClipboardSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        MaxLines="2" />
                    <Button Grid.Column="1" Content="{x:Bind Localize('WorkspacePrivacy')}" Padding="10,0" Height="32">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Text="{x:Bind Localize('WorkspacePause15')}"
                                    Command="{x:Bind Controls.Pause15Command}" />
                                <MenuFlyoutItem
                                    Text="{x:Bind Localize('WorkspacePauseHour')}"
                                    Command="{x:Bind Controls.PauseHourCommand}" />
                                <MenuFlyoutItem
                                    Text="{x:Bind Localize('WorkspacePauseManual')}"
                                    Command="{x:Bind Controls.PauseUntilResumeCommand}" />
                                <MenuFlyoutItem
                                    Text="{x:Bind Localize('WorkspaceResume')}"
                                    Command="{x:Bind Controls.ResumeCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Text="{x:Bind Controls.PresentationAction, Mode=OneWay}"
                                    Command="{x:Bind Controls.TogglePresentationCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TextBlock
                    Text="{x:Bind Controls.Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Visibility="{x:Bind MessageVisibility(Controls.Error), Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </Grid>
        <ContentControl
            x:Name="WorkspaceHost"
            Visibility="Collapsed"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        <StackPanel
            x:Name="PresentationPanel"
            Visibility="Collapsed"
            Padding="24"
            Spacing="16"
            VerticalAlignment="Center">
            <TextBlock
                Text="{x:Bind Localize('WorkspacePresentation')}"
                Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind Localize('WorkspacePresentationHelp')}" TextWrapping="Wrap" />
            <Button
                Content="{x:Bind Controls.PresentationAction, Mode=OneWay}"
                Command="{x:Bind Controls.TogglePresentationCommand}" />
            <TextBlock Text="{x:Bind Controls.CaptureStatus, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Controls.Error, Mode=OneWay}" TextWrapping="Wrap" />
            <Button Content="{x:Bind CloseTooltip}" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</api:SillPopupContent>
