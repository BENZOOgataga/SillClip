<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowSill.ClipboardHistory.ViewModels"
    x:Class="WindowSill.ClipboardHistory.Views.ClipboardWorkspaceView"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///WindowSill.ClipboardHistory/UI/ClipboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Style="{StaticResource ClipboardToolbarButtonStyle}"
                Click="Back_Click"
                ToolTipService.ToolTip="{x:Bind Localize('WorkspaceBack')}"
                AutomationProperties.Name="{x:Bind Localize('WorkspaceBack')}">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Text="{x:Bind Localize('WorkspaceLibraryTitle')}"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind Controls.CaptureStatus, Mode=OneWay}"
                    Style="{StaticResource ClipboardSecondaryTextStyle}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Style="{StaticResource ClipboardToolbarButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Controls.PresentationAction, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Controls.PresentationAction, Mode=OneWay}"
                Command="{x:Bind Controls.TogglePresentationCommand}"
                IsEnabled="{x:Bind Controls.CanInteract, Mode=OneWay}">
                <FontIcon Glyph="&#xE7B3;" FontSize="16" />
            </Button>
        </Grid>
        <TabView
            Grid.Row="1"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False"
            TabWidthMode="SizeToContent"
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
            x:Name="WorkspaceTabs"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}"
            SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabViewItem Header="{x:Bind Localize('WorkspaceBrowse')}" IsClosable="False">
                <Grid RowSpacing="12" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox
                        PlaceholderText="{x:Bind Localize('SearchPlaceholder')}"
                        Text="{x:Bind ViewModel.History.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{x:Bind Localize('SearchPlaceholder')}"
                        ToolTipService.ToolTip="{x:Bind Localize('WorkspaceQueryHelp')}" />
                    <CommandBar
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        Grid.Row="1"
                        VerticalContentAlignment="Center">
                        <CommandBar.Content>
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ClipboardSecondaryTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                MaxWidth="240"
                                Margin="0,0,12,0" />
                        </CommandBar.Content>
                        <AppBarButton
                            Label="{x:Bind Localize('Copy')}"
                            Command="{x:Bind ViewModel.CopySelectedCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Label="{x:Bind Localize('Paste')}"
                            Command="{x:Bind ViewModel.PasteSelectedCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE77F;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceAddToQueue')}"
                            Command="{x:Bind ViewModel.Queue.AddCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <ListView
                        x:Name="BrowseList"
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.History.Items}"
                        SelectionMode="Multiple"
                        SelectionChanged="BrowseList_SelectionChanged"
                        HorizontalContentAlignment="Stretch"
                        ItemContainerStyle="{StaticResource ClipboardWorkspaceListItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipboardHistoryItemViewModelBase">
                                <Grid Padding="4" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Summary, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Text="{x:Bind TypeName, Mode=OneWay}"
                                            Style="{StaticResource ClipboardSecondaryTextStyle}" />
                                        <TextBlock
                                            Text="{x:Bind CapturedAtText, Mode=OneWay}"
                                            Style="{StaticResource ClipboardSecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Spacing="4" Grid.Row="3">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Localize('WorkspacePasteMode')}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ClipboardSecondaryTextStyle}" />
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.PasteOptions.Modes}"
                                SelectedIndex="{x:Bind ViewModel.PasteOptions.TransformIndex, Mode=TwoWay}"
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind Localize('WorkspacePasteMode')}"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.History.QueryError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.History.QueryErrorVisibility, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="2"
                        Text="{x:Bind Localize('WorkspaceBrowseEmpty')}"
                        Visibility="{x:Bind ViewModel.History.EmptyClipboardIndicatorVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Style="{StaticResource ClipboardSecondaryTextStyle}"
                        IsHitTestVisible="False" />
                    <TextBlock
                        Grid.Row="2"
                        Text="{x:Bind Localize('NoSearchResults')}"
                        Visibility="{x:Bind ViewModel.History.NoSearchResultsVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Style="{StaticResource ClipboardSecondaryTextStyle}"
                        IsHitTestVisible="False" />
                </Grid>
            </TabViewItem>
            <TabViewItem Header="{x:Bind Localize('WorkspaceCollections')}" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,12,8,8" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind Localize('WorkspaceCollectionHelp')}" TextWrapping="Wrap" />
                        <TextBox
                            MaxLength="80"
                            Text="{x:Bind ViewModel.Collections.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Header="{x:Bind Localize('WorkspaceNewCollection')}" />
                        <Button
                            Content="{x:Bind Localize('WorkspaceCreateCollection')}"
                            Command="{x:Bind ViewModel.Collections.CreateCommand}" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.Collections.Names}"
                            SelectedItem="{x:Bind ViewModel.Collections.SelectedName, Mode=TwoWay}"
                            PlaceholderText="{x:Bind Localize('WorkspaceChooseCollection')}"
                            HorizontalAlignment="Stretch"
                            Header="{x:Bind Localize('WorkspaceChooseCollection')}" />
                        <CommandBar
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            VerticalContentAlignment="Center">
                            <CommandBar.Content>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ClipboardSecondaryTextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2"
                                    MaxWidth="240"
                                    Margin="0,0,12,0" />
                            </CommandBar.Content>
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspaceAssignCollection')}"
                                Command="{x:Bind ViewModel.Collections.AssignCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspaceFilterCollection')}"
                                Command="{x:Bind ViewModel.Collections.ShowCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton
                                    Label="{x:Bind Localize('WorkspaceRemoveMembership')}"
                                    Command="{x:Bind ViewModel.Collections.RemoveMembershipCommand}">
                                    <AppBarButton.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE738;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    Label="{x:Bind Localize('WorkspaceDeleteCollection')}"
                                    Command="{x:Bind ViewModel.Collections.DeleteCommand}">
                                    <AppBarButton.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="{x:Bind Localize('WorkspaceCompare')}" IsClosable="False">
                <Grid Padding="0,12,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Localize('WorkspaceCompareHelp')}" TextWrapping="Wrap" />
                    <CommandBar
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        Grid.Row="1"
                        VerticalContentAlignment="Center">
                        <CommandBar.Content>
                            <TextBlock
                                Text="{x:Bind ViewModel.Comparison.Summary, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ClipboardSecondaryTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                MaxWidth="240"
                                Margin="0,0,12,0" />
                        </CommandBar.Content>
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceCompare')}"
                            Command="{x:Bind ViewModel.Comparison.CompareCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceCopyDiff')}"
                            Command="{x:Bind ViewModel.Comparison.CopyCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <TextBox
                        Grid.Row="2"
                        Text="{x:Bind ViewModel.Comparison.Diff, Mode=OneWay}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        AutomationProperties.Name="{x:Bind Localize('WorkspaceCompare')}" />
                </Grid>
            </TabViewItem>
            <TabViewItem Header="{x:Bind Localize('WorkspaceQueue')}" IsClosable="False">
                <Grid Padding="0,12,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CommandBar
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        VerticalContentAlignment="Center">
                        <CommandBar.Content>
                            <TextBlock
                                Text="{x:Bind ViewModel.Queue.CountText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ClipboardSecondaryTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                MaxWidth="240"
                                Margin="0,0,12,0" />
                        </CommandBar.Content>
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceAddToQueue')}"
                            Command="{x:Bind ViewModel.Queue.AddCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Queue.Entries}"
                        SelectedItem="{x:Bind ViewModel.Queue.SelectedEntry, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource ClipboardWorkspaceListItemStyle}"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueRow">
                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" MaxLines="2" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <CommandBar
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        Grid.Row="2"
                        VerticalContentAlignment="Center">
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceMoveUp')}"
                            Command="{x:Bind ViewModel.Queue.MoveUpCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE70E;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceMoveDown')}"
                            Command="{x:Bind ViewModel.Queue.MoveDownCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE70D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Label="{x:Bind Localize('Delete')}"
                            Command="{x:Bind ViewModel.Queue.RemoveCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <CommandBar.SecondaryCommands>
                            <AppBarButton
                                Label="{x:Bind Localize('ClearAll')}"
                                Command="{x:Bind ViewModel.Queue.ClearCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE894;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <StackPanel Spacing="8" Grid.Row="3">
                        <ComboBox
                            SelectedIndex="{x:Bind ViewModel.Queue.SeparatorIndex, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind Localize('WorkspaceSeparator')}"
                            Header="{x:Bind Localize('WorkspaceSeparator')}"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{x:Bind Localize('WorkspaceNewLine')}" />
                            <ComboBoxItem Content="{x:Bind Localize('WorkspaceTabSeparator')}" />
                            <ComboBoxItem Content="{x:Bind Localize('WorkspaceBlankLine')}" />
                        </ComboBox>
                        <CommandBar
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            VerticalContentAlignment="Center">
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspacePasteNext')}"
                                Command="{x:Bind ViewModel.Queue.PasteNextCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE77F;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspacePasteTogether')}"
                                Command="{x:Bind ViewModel.Queue.PasteTogetherCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE77F;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </StackPanel>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="{x:Bind Localize('WorkspaceStorage')}" IsClosable="False">
                <Grid Padding="0,12,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CommandBar
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        VerticalContentAlignment="Center">
                        <CommandBar.Content>
                            <TextBlock
                                Text="{x:Bind ViewModel.Storage.OverviewText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource ClipboardSecondaryTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                MaxWidth="240"
                                Margin="0,0,12,0" />
                        </CommandBar.Content>
                        <AppBarButton
                            Label="{x:Bind Localize('WorkspaceRefreshStorage')}"
                            Command="{x:Bind ViewModel.Storage.RefreshCommand}">
                            <AppBarButton.Icon>
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Storage.Entries}"
                        SelectedItem="{x:Bind ViewModel.Storage.SelectedEntry, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource ClipboardWorkspaceListItemStyle}"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageRow">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Label}" MaxLines="2" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Size}" />
                                        <TextBlock Text="{x:Bind Date}" />
                                        <TextBlock Text="{x:Bind PinLabel}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CalendarDatePicker
                                Header="{x:Bind Localize('WorkspaceFromDate')}"
                                Date="{x:Bind ViewModel.Storage.FromDate, Mode=TwoWay}"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Grid.Column="0" />
                            <CalendarDatePicker
                                Header="{x:Bind Localize('WorkspaceThroughDate')}"
                                Date="{x:Bind ViewModel.Storage.ThroughDate, Mode=TwoWay}"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Grid.Column="1" />
                        </Grid>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <CheckBox
                                Content="{x:Bind Localize('WorkspaceImagesOnly')}"
                                IsChecked="{x:Bind ViewModel.Storage.ImagesOnly, Mode=TwoWay}" />
                            <CheckBox
                                Content="{x:Bind Localize('WorkspaceIncludePins')}"
                                IsChecked="{x:Bind ViewModel.Storage.IncludePins, Mode=TwoWay}" />
                        </StackPanel>
                        <CommandBar
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            VerticalContentAlignment="Center">
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspaceDeleteSelected')}"
                                Command="{x:Bind ViewModel.Storage.DeleteSelectedCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspaceCleanRange')}"
                                Command="{x:Bind ViewModel.Storage.CleanRangeCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE894;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </StackPanel>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="{x:Bind Localize('WorkspaceBackup')}" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="0,12,8,8" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind Localize('WorkspaceBackupHelp')}" TextWrapping="Wrap" />
                        <PasswordBox
                            Header="{x:Bind Localize('WorkspacePassphrase')}"
                            MaxLength="1024"
                            Password="{x:Bind ViewModel.Backup.Password, Mode=TwoWay}" />
                        <PasswordBox
                            Header="{x:Bind Localize('WorkspaceConfirmPassphrase')}"
                            MaxLength="1024"
                            Password="{x:Bind ViewModel.Backup.Confirmation, Mode=TwoWay}" />
                        <CheckBox
                            Content="{x:Bind Localize('WorkspaceFileReferences')}"
                            IsChecked="{x:Bind ViewModel.Backup.LocalFileReferences, Mode=TwoWay}" />
                        <TextBlock
                            Text="{x:Bind Localize('WorkspaceFileReferenceHelp')}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CommandBar
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            VerticalContentAlignment="Center">
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspaceExport')}"
                                Command="{x:Bind ViewModel.Backup.ExportCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                Label="{x:Bind Localize('WorkspaceImport')}"
                                Command="{x:Bind ViewModel.Backup.ImportCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
        <StackPanel
            Grid.Row="2"
            Spacing="4"
            Visibility="{x:Bind StatusVisibility(ViewModel.Status, ViewModel.IsBusy), Mode=OneWay}">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind BusyVisibility(ViewModel.IsBusy), Mode=OneWay}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
                <Button
                    Grid.Column="1"
                    Content="{x:Bind Localize('WorkspaceCancel')}"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind BusyVisibility(ViewModel.IsBusy), Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
